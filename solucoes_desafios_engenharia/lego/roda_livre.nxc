// Runs on NXT LEGO
// Sistema roda livre para orientação do mockup de satelite 

#define LIGHT_PORT IN_3
#define MOTOR_A OUT_A
#define MOTOR_B OUT_B

// Configurações
#define LUZ_ALVO 30          // Valor de luz que o robô considera "ideal"
#define HISTERESE_ALVO 5     // Histerese para o alvo (só volta a procurar se a luz cair abaixo de LUZ_ALVO - HISTERESE_ALVO)
#define HISTERESE_QUEDA 3    // Queda de luz necessária para considerar que passou do alvo (evita falsas detecções por ruído)
#define TEMPO_ON 800          // Tempo de acionamento dos motores (ms)
#define TEMPO_OFF 200        // Tempo com motores desligados para evitar inércia (ms)
#define TEMPO_FREIO 300      // Tempo do pulso reverso (freio/recuo)
#define VELOCIDADE 100        // Velocidade base dos motores

task main() {
    // Toca musiquinha de boot original (sequência de inicialização de sistema)
    PlayTone(261, 100); Wait(120); // Dó
    PlayTone(329, 100); Wait(120); // Mi
    PlayTone(392, 100); Wait(120); // Sol
    PlayTone(523, 150); Wait(170); // Dó agudo
    PlayTone(392, 100); Wait(120); // Sol
    PlayTone(523, 100); Wait(120); // Dó agudo
    PlayTone(659, 250); Wait(300); // Mi agudo (encerra)

    // Inicializa o sensor de luz na porta 3
    SetSensorLight(LIGHT_PORT);
    
    int luz_atual = Sensor(LIGHT_PORT);
    int luz_anterior = luz_atual;
    // O sentido principal de busca será sempre para frente (1)

    while (true) {
        // 1. Lê o valor atual do sensor
        luz_atual = Sensor(LIGHT_PORT);

        // 2. Verifica se a luz alvo foi alcançada
        // Usamos histerese para que o motor não fique ligando e desligando no limiar
        if (luz_atual >= LUZ_ALVO) {
            Off(MOTOR_A);
            Off(MOTOR_B);
            
            ClearScreen();
            TextOut(0, LCD_LINE1, "ALVO ALCANCADO!");
            TextOut(0, LCD_LINE3, "Luz Atual:");
            NumOut(70, LCD_LINE3, luz_atual); 

            // Aviso sonoro: bipe de 1000Hz por 500ms
            PlayTone(1000, 500); 

            // Fica em repouso até a luz cair fora da zona de histerese
            while (Sensor(LIGHT_PORT) > LUZ_ALVO - HISTERESE_ALVO) {
                Wait(100);
            }
            
            // Quando a luz sair da zona de histerese, atualiza a referência e recomeça
            luz_anterior = Sensor(LIGHT_PORT);
            continue;
        }

        // 3. Avalia se passou da fonte de luz (a luz começou a diminuir)
        if (luz_atual < luz_anterior - HISTERESE_QUEDA) {
            // Passou do pico. Como girar no sentido -1 é difícil, usamos ele apenas como "freio"
            // (um recuo curto e rápido) e depois voltamos a priorizar a busca no sentido 1.
            OnRev(MOTOR_A, VELOCIDADE);
            OnRev(MOTOR_B, VELOCIDADE);
            Wait(TEMPO_FREIO);
            Off(MOTOR_A);
            Off(MOTOR_B);
            Wait(TEMPO_OFF);
            
            // Atualiza a luz após o freio para não acionar o recuo várias vezes seguidas
            luz_anterior = Sensor(LIGHT_PORT); 
            continue; // Recomeça o loop para nova medição e continua a busca no sentido 1
        } else if (luz_atual > luz_anterior) {
            // Se a luz está aumentando, estamos no caminho certo, atualizamos o pico local
            luz_anterior = luz_atual;
        }

        // 4. Aciona os motores: prioridade total para o sentido 1 (OnFwd)
        OnFwd(MOTOR_A, VELOCIDADE);
        OnFwd(MOTOR_B, VELOCIDADE);

        
        // Tempo de pulso ligado
        Wait(TEMPO_ON);
        
        // Desliga e aguarda inércia dissipar antes da próxima leitura
        Off(MOTOR_A);
        Off(MOTOR_B);
        Wait(TEMPO_OFF);
        
        // 5. Atualiza a tela com as informações
        ClearScreen(); 
        TextOut(0, LCD_LINE1, "Buscando Luz...");
        
        TextOut(0, LCD_LINE3, "Luz Atual:");
        NumOut(70, LCD_LINE3, luz_atual); 

        TextOut(0, LCD_LINE5, "Luz Ant.:");
        NumOut(70, LCD_LINE5, luz_anterior); 
    }
}